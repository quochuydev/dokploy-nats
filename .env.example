# Identity
NATS_SERVER_NAME=nats-server

# Auth — generate a strong random token (e.g. openssl rand -hex 32)
NATS_AUTH_TOKEN=replace-me

# Ports (internal — exposed to the Docker network only)
NATS_HTTP_PORT=8222
NATS_WS_PORT=8080

# Limits
NATS_MAX_PAYLOAD=1MB
NATS_MAX_CONNECTIONS=64K

# JetStream storage limits
NATS_JS_MAX_MEMORY=1G
NATS_JS_MAX_FILE=10G
